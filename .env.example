# Example environment variables for local development and Qdrant Cloud
# Copy this file to `.env` and fill values. Do NOT commit your `.env` to git.

# Gemini / Google API key (if using Gemini or other LLM provider)
GEMINI_API_KEY=

# Qdrant Cloud or remote Qdrant URL (for cloud: an https URL; for local: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# Qdrant API key for cloud deployments. Leave empty for local Docker without auth.
QDRANT_API_KEY=
